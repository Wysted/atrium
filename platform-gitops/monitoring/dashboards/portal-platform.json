      "uid": "${datasource}"
     },
     "expr": "max by (status) (portal_deployments_by_probe_status)",
     "legendFormat": "{{status}}",
     "refId": "A",
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "drawStyle": "line",
