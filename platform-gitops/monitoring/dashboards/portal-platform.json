  {
   "id": 18,
   "type": "row",
   "title": "Database pools",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 39
   },
   "panels": []
  },
  {
   "id": 19,
   "type": "timeseries",
   "title": "DB pool usage (acquired / max)",
   "description": "DBPoolSaturated fires above 90% for 10 minutes.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 40
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "platform_db_pool_acquired_connections / platform_db_pool_max_connections",
     "legendFormat": "platform-api {{pod}}",
     "refId": "A",
     "range": true
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
