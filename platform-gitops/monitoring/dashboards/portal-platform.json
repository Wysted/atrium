    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "textMode": "auto"
   }
  },
  {
   "id": 7,
   "type": "stat",
   "title": "Active signing key age",
   "description": "Seconds since the active signing key was activated (rotation age). Absent while no replica has a signer.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 20,
