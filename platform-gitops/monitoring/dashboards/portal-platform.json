{
 "uid": "portal-platform",
 "title": "Portal platform",
 "tags": [
  "portal",
  "platform"
 ],
 "timezone": "browser",
 "editable": false,
 "graphTooltip": 1,
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "description": "platform-api and portal metrics (platform/docs/contract.md, block 6). Needs jobs 'platform-api' and 'portal'.",
 "templating": {
  "list": [
   {
    "name": "datasource",
    "label": "Data source",
    "type": "datasource",
    "query": "prometheus",
    "current": {},
    "hide": 0,
    "refresh": 1,
    "regex": "",
    "includeAll": false,
    "multi": false
   }
  ]
 },
 "annotations": {
  "list": []
 },
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Overview",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "panels": []
  },
  {
   "id": 2,
   "type": "stat",
   "title": "platform-api targets up",
   "description": "Replicas of platform-api answering the scrape. 0 means ForwardAuth is down (alert ForwardAuthDown).",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 0,
    "y": 1
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum(up{job=\"platform-api\"})",
     "legendFormat": "up",
     "refId": "A",
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     },
     "mappings": [],
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "textMode": "auto"
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "portal targets up",
   "description": "Replicas of the portal answering the scrape (alert PortalDown).",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 4,
    "y": 1
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum(up{job=\"portal\"})",
     "legendFormat": "up",
     "refId": "A",
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     },
     "mappings": [],
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "textMode": "auto"
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Unprotected deployments",
   "description": "Deployments that answered the last integration probe without the login redirect: reachable WITHOUT ForwardAuth (alert UnprotectedDeployment). No data means the portal cannot count (alert ProbeStatusCountErrors).",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 8,
    "y": 1
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "max(portal_deployments_by_probe_status{status=\"unprotected\"})",
     "legendFormat": "unprotected",
     "refId": "A",
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     },
     "mappings": [],
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "textMode": "auto"
   }
  },
  {
   "id": 5,
   "type": "stat",
   "title": "Replicas with a signing key",
   "description": "Replicas that can sign / replicas reporting. A replica without a key cannot let anyone in (alert SigningKeyNotLoaded).",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 12,
    "y": 1
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum(platform_signing_key_loaded)",
     "legendFormat": "loaded",
     "refId": "A",
     "range": true
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "count(platform_signing_key_loaded)",
     "legendFormat": "replicas",
     "refId": "B",
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     },
     "mappings": [],
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "textMode": "auto"
   }
  },
  {
   "id": 6,
   "type": "stat",
   "title": "Replicas with a KEK mismatch",
   "description": "Replicas whose KEK does not open the stored signing keys (alert SigningKeyKEKMismatch).",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 16,
