#!/usr/bin/env bash
# Run a Go command inside the portal go container, in the current subdirectory (no args opens a shell).
# Examples: ./gk go version | (cd platform/api && ../../gk go test ./...)
set -euo pipefail

root="$(cd "$(dirname "$0")" && pwd)"
rel="$(realpath --relative-to="$root" "$PWD")"
case "$rel" in
  ..*) rel="." ;;
esac

cd "$root"
mkdir -p .tools/home .tools/go/path .tools/go/cache .tools/go/mod

export LOCAL_UID="$(id -u)"
export LOCAL_GID="$(id -g)"

if [ "$#" -eq 0 ]; then
  set -- bash
fi

exec docker compose run --rm -w "/workspace/$rel" go "$@"
